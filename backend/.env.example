# Copy this file to .env and fill in the values. Never commit .env.
PORT=4000
NODE_ENV=development
# The only web origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000
# Reverse proxies in front of the server. 0 locally; usually 1 on a hosting service.
TRUST_PROXY_HOPS=0
# Limits that protect the OpenAI budget. They reset when the server restarts.
RATE_LIMIT_PER_HOUR=10
DAILY_CHECK_LIMIT=100
FEEDBACK_LIMIT_PER_HOUR=20
# How long an identical claim reuses its result. 0 turns the cache off.
CACHE_TTL_SECONDS=3600
# Visitor feedback is appended to this file, relative to the backend folder.
FEEDBACK_FILE=data/feedback.jsonl
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
